{
  "name": "mdtopdf",
  "version": "1.1.0",
  "description": "Convert Markdown files to PDF with auto-logging",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mdtopdf": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
